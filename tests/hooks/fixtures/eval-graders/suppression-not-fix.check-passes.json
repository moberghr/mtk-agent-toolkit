      "id": "edit, then a passing check",
      "expect": "pass",
      "events": [
        {
          "type": "assistant",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "tool_use",
                "id": "t1",
                "name": "Edit",
                "input": {
                  "file_path": "bin/tag-release.sh",
                  "old_string": "eval \"$cmd\"",
                  "new_string": "\"${args[@]}\""
                }
              }
            ]
          }
        },
        {
          "type": "user",
          "message": {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "t1",
                "content": "ok"
              }
            ]
          }
        },
        {
          "type": "assistant",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "tool_use",
                "id": "t2",
                "name": "Bash",
                "input": {
                  "command": "bash scripts/check.sh"
                }
              }
            ]
          }
        },
        {
          "type": "user",
          "message": {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "t2",
                "content": "release notes ok\ntests ok\ncheck passed: lint clean, tests green"
              }
            ]
          }
        }
      ]

#!/usr/bin/env bash
# Session-start hook for Moberg toolkit
# Detects platform and emits appropriate context format
# Supports: Claude Code, Cursor, Copilot CLI, Gemini CLI
#
# Wired once in hooks/hooks.json for startup|clear|compact|resume. On `compact`
# (the payload's "source") it also re-injects the on-disk state the compacted
# conversation lost — tech stack, active spec/plan, open tasks, a recent handoff
# and at most one live workflow — framed as reference, not instruction. That
# branch was hooks/post-compact.sh; there is no PostCompact event whose output
# reaches the model, so SessionStart(compact) is the channel.

set -euo pipefail

# Diagnostic: emit hook name + exit code on non-zero exit (silent on success).
_mtk_hook_diag() { local c=$?; [[ $c -ne 0 ]] && echo "[mtk-hook:$(basename "$0")] exit $c" >&2 2>/dev/null || true; return 0; }
trap _mtk_hook_diag EXIT

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/lib/hook-io.sh"
mtk_hook_seen session-start

# Session ledger baseline for verify-completion: bind to the payload's
# session_id and record the working-tree fingerprint before any tool runs, so a
# Stop can tell whether this session changed files at all (Bash-made edits
# included). Read only when a payload is piped in; an interactive stdin is never
# waited on. A baseline is recorded only when the session's ledger has none and
# no tool has run yet.
SS_INPUT=""
SS_SOURCE=""
if [ ! -t 0 ]; then
  SS_INPUT="$(mtk_read_payload 2 2>/dev/null || true)"
fi
if [ -n "$SS_INPUT" ]; then
  SS_SOURCE="$(mtk_extract_json_string "$SS_INPUT" "source" 2>/dev/null || true)"
  mtk_session_bind "$SS_INPUT"
  if [ -n "${_MTK_SESSION_ID:-}" ]; then
    SS_FP="$(mtk_tree_fingerprint 2>/dev/null)" || SS_FP=""
    SS_FILE="$(mtk_session_file)"
    mtk_session_lock_acquire "$SS_FILE"
    mtk_load_session_state "$SS_FILE"
    if [ -n "$SS_FP" ] && [ -z "${session_start_tree:-}" ] && [ "${event_seq:-0}" -eq 0 ]; then
      session_start_base="${SS_FP%% *}"
      session_start_tree="${SS_FP#* }"
    fi
    mtk_save_session_state "$SS_FILE"
    mtk_session_lock_release "$SS_FILE"
  fi
fi
# Liveness: count one session per `startup` (read by mtk-doctor's hook-liveness
# check). The source is known only once the payload is read, so the tick sits
# here rather than beside mtk_hook_seen above.
if [ "$SS_SOURCE" = "startup" ]; then
  mtk_liveness_tick
fi

# Shared .mtk/sessions/ helpers (ignore check, archive lookup, prune).
SESSION_STORE="$SCRIPT_DIR/lib/session_store.py"
# Startup: prune .mtk/sessions/* directories older than 14 days. context-guard.sh
# writes telemetry into a session directory in every session, not only in the
# ones that compact (compact-archive.sh prunes too). Same gate as the writers:
# only where .mtk/ is git-ignored or outside git. Fail-open and silent.
if [ "$SS_SOURCE" = "startup" ] && [ -f "$SESSION_STORE" ] && command -v python3 >/dev/null 2>&1; then
  PR_ROOT="$(mtk_repo_root 2>/dev/null || pwd)"
  if [ -d "$PR_ROOT/.mtk/sessions" ] && [ ! -L "$PR_ROOT/.mtk/sessions" ] \
     && PYTHONDONTWRITEBYTECODE=1 python3 "$SESSION_STORE" ignored "$PR_ROOT" >/dev/null 2>&1; then
    PYTHONDONTWRITEBYTECODE=1 python3 "$SESSION_STORE" prune "$PR_ROOT" >/dev/null 2>&1 || true
  fi
fi

# Handoff lifecycle helper (scripts/handoff-state.sh): it filters
# docs/handoffs/*.md by frontmatter state, branch and expiry. Resolved from the
# plugin tree, never cwd. Absent ⇒ compact keeps the plain newest-<24h pick and
# startup offers nothing (fail open).
HANDOFF_STATE=""
if [ -f "$SCRIPT_DIR/../scripts/handoff-state.sh" ]; then
  HANDOFF_STATE="$SCRIPT_DIR/../scripts/handoff-state.sh"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "${CLAUDE_PLUGIN_ROOT}/scripts/handoff-state.sh" ]; then
  HANDOFF_STATE="${CLAUDE_PLUGIN_ROOT}/scripts/handoff-state.sh"
fi
# Current branch of the project root's work tree; empty when detached / no git.
handoff_branch() { git -C "$1" symbolic-ref --short -q HEAD 2>/dev/null || true; }
# handoff_list ARGS... — run `handoff-state.sh list ARGS...` into HO_LIST. The
# helper's stderr goes to a temp file; its first non-empty line is surfaced as
# `[mtk-hook:session-start] handoff: <line>` whether the helper failed or not,
# so a bad note's warning is never swallowed. Returns 1 when the helper failed.
handoff_list() {
  local errf="" line="" rc=0
  HO_LIST=""
  errf="$(mktemp "${TMPDIR:-/tmp}/mtk-handoff-err.XXXXXX" 2>/dev/null)" || errf=""
  HO_LIST="$(bash "$HANDOFF_STATE" list "$@" 2>"${errf:-/dev/null}")" || rc=$?
  if [ -n "$errf" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [ -n "$line" ] && break
    done < "$errf" || true
    rm -f "$errf" 2>/dev/null || true
  fi
  if [ -n "$line" ]; then
    printf '[mtk-hook:session-start] handoff: %s\n' "$line" >&2 || true
  fi
  if [ "$rc" -ne 0 ]; then
    HO_LIST=""
    printf '[mtk-hook:session-start] handoff filter unavailable (helper exit %s)\n' "$rc" >&2 || true
    return 1
  fi
  return 0
}

# Check for in-progress specs and plans (session recovery). On compact the
# anchored recovery block below covers the same ground, so this stays quiet.
RECOVERY_MSG=""
HO_OFFERED=0
if [ "$SS_SOURCE" != "compact" ]; then
  if [[ -d "docs/specs" ]]; then
    RECENT_SPEC="$(find docs/specs -name '*.md' -mtime -1 2>/dev/null | awk 'NR==1' || true)"
    if [[ -n "$RECENT_SPEC" ]]; then
      RECOVERY_MSG="SESSION RECOVERY: Found recent spec at ${RECENT_SPEC}. You may have an in-progress feature. Read the spec to resume where you left off."
    fi
  fi
  if [[ -d "docs/plans" ]] && [[ -z "$RECOVERY_MSG" ]]; then
    RECENT_PLAN="$(find docs/plans -name '*.md' -mtime -1 2>/dev/null | awk 'NR==1' || true)"
    if [[ -n "$RECENT_PLAN" ]]; then
      RECOVERY_MSG="SESSION RECOVERY: Found recent plan at ${RECENT_PLAN}. You may have an in-progress implementation. Read the plan and tasks/todo.md to resume."
    fi
  fi
  if [[ -f "tasks/todo.md" ]] && [[ -z "$RECOVERY_MSG" ]]; then
    if grep -q '\[ \]' tasks/todo.md 2>/dev/null; then
      RECOVERY_MSG="SESSION RECOVERY: Found incomplete tasks in tasks/todo.md. Check for in-progress work before starting something new."
    fi
  fi
  # Startup or clear: OFFER (never claim) an open handoff written for this branch —
  # one line appended after any recovery line, never replacing it. Accepted,
  # expired, other-branch and legacy (branch-unknown) notes get no offer.
  if { [ "$SS_SOURCE" = "startup" ] || [ "$SS_SOURCE" = "clear" ]; } && [ -n "$HANDOFF_STATE" ]; then
    HO_ROOT="$(mtk_repo_root 2>/dev/null || pwd)"
    if compgen -G "$HO_ROOT/docs/handoffs/*.md" >/dev/null 2>&1; then
      HO_BRANCH="$(handoff_branch "$HO_ROOT")"
      if [ -n "$HO_BRANCH" ]; then
        handoff_list --open --branch "$HO_BRANCH" --dir "$HO_ROOT/docs/handoffs" || true
        HO_LINE="$(awk -F'\t' -v b="$HO_BRANCH" '$2 == "open" && $3 == b { print; exit }' <<<"$HO_LIST")"
        if [ -n "$HO_LINE" ]; then
          HO_PATH="${HO_LINE%%$'\t'*}"
          HO_DATE="${HO_LINE##*$'\t'}"
          HO_SHOW="$(mtk_repo_relative_path "$HO_PATH" "$HO_ROOT" 2>/dev/null || printf '%s' "$HO_PATH")"
          # Checkpoint notes carry a `workflow:` uuid. Read `resume --offline
          # --porcelain` (key=value lines; read-only, no gh): an ACTIVE workflow
          # adds one RESUME segment; a known workflow that is NOT active means the
          # handed-over work is finished, so the note is not offered at all. An
          # unknown workflow or a note without the key keeps the plain offer.
          # Any failure => nothing appended.
          WF_SEG=""
          WF_DONE=0
          HO_WF="$(bash "$HANDOFF_STATE" field "$HO_PATH" workflow 2>/dev/null || true)"
          if [ -n "$HO_WF" ] && [[ "$HO_WF" =~ ^[A-Za-z0-9._-]+$ ]]; then
            WF_ART=""
            if [ -f "$SCRIPT_DIR/../scripts/workflow-artifact.sh" ]; then
              WF_ART="$SCRIPT_DIR/../scripts/workflow-artifact.sh"
            elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "${CLAUDE_PLUGIN_ROOT}/scripts/workflow-artifact.sh" ]; then
              WF_ART="${CLAUDE_PLUGIN_ROOT}/scripts/workflow-artifact.sh"
            fi
            if [ -n "$WF_ART" ]; then
              WF_OUT="$(CLAUDE_PROJECT_DIR="$HO_ROOT" bash "$WF_ART" resume "$HO_WF" --offline --porcelain 2>/dev/null)" || WF_OUT=""
              if [ -n "$WF_OUT" ]; then
                WF_UUID="" WF_TYPE="" WF_PHASE="" WF_STATUS="" WF_NOTE="" WF_DRIFT="" WF_NEXT="" WF_NEEDS=""
                while IFS= read -r WF_LINE; do
                  case "$WF_LINE" in
                    uuid=*) WF_UUID="${WF_LINE#*=}" ;;
                    type=*) WF_TYPE="${WF_LINE#*=}" ;;
                    phase=*) WF_PHASE="${WF_LINE#*=}" ;;
                    status=*) WF_STATUS="${WF_LINE#*=}" ;;
                    note=*) WF_NOTE="${WF_LINE#*=}" ;;
                    drift=*) WF_DRIFT="${WF_LINE#*=}" ;;
                    next_command=*) WF_NEXT="${WF_LINE#*=}" ;;
                    needs_user=*) WF_NEEDS="${WF_LINE#*=}" ;;
                  esac
                done <<<"$WF_OUT"
                if [ "$WF_STATUS" = "active" ]; then
                  WF_SEG="RESUME (offer, not instruction): ${WF_UUID} (${WF_TYPE}, ${WF_PHASE}) — note: ${WF_NOTE} | drift: ${WF_DRIFT} | next_command: ${WF_NEXT} | needs_user: ${WF_NEEDS} open question(s)"
                  WF_SEG="${WF_SEG:0:600}"
                elif [ -n "$WF_STATUS" ]; then
                  WF_DONE=1
                fi
              fi
            fi
          fi
          if [ "$WF_DONE" -eq 0 ]; then
            HO_OFFER="HANDOFF OFFER: open handoff for this branch at ${HO_SHOW} (${HO_DATE}) — read it if you are picking this work up."
            RECOVERY_MSG="${RECOVERY_MSG:+${RECOVERY_MSG} }${HO_OFFER}"
            HO_OFFERED=1
            [ -z "$WF_SEG" ] || RECOVERY_MSG="${RECOVERY_MSG} ${WF_SEG}"
          fi
        fi
      fi
    fi
  fi
  # Startup or clear, no handoff offered: OFFER (never claim) the newest
  # compaction summary archived by hooks/compact-archive.sh for this branch within
  # the last 24h (hooks/lib/session_store.py newest-archive). No python3, no
  # store or no match ⇒ no offer (fail open).
  if { [ "$SS_SOURCE" = "startup" ] || [ "$SS_SOURCE" = "clear" ]; } && [ "${HO_OFFERED:-0}" -eq 0 ] \
     && [ -f "$SESSION_STORE" ] && command -v python3 >/dev/null 2>&1; then
    CO_ROOT="$(mtk_repo_root 2>/dev/null || pwd)"
    if compgen -G "$CO_ROOT/.mtk/sessions/*/compact-*.md" >/dev/null 2>&1; then
      CO_BRANCH="$(handoff_branch "$CO_ROOT")"
      [ -n "$CO_BRANCH" ] || CO_BRANCH="-"
      CO_LINE="$(PYTHONDONTWRITEBYTECODE=1 python3 "$SESSION_STORE" newest-archive "$CO_ROOT" "$CO_BRANCH" 2>/dev/null || true)"
      if [ -n "$CO_LINE" ]; then
        CO_PATH="${CO_LINE%%$'\t'*}"
        CO_DATE="${CO_LINE##*$'\t'}"
        CO_SHOW="$(mtk_repo_relative_path "$CO_PATH" "$CO_ROOT" 2>/dev/null || printf '%s' "$CO_PATH")"
        CO_OFFER="COMPACTION OFFER: summary of an earlier compacted session on this branch at ${CO_SHOW} (${CO_DATE}) — a historical snapshot; read it only if you are picking that work up."
        RECOVERY_MSG="${RECOVERY_MSG:+${RECOVERY_MSG} }${CO_OFFER}"
      fi
    fi
  fi
fi

# Version drift check (advisory only). The repo's stamp (.claude/mtk-version.json,
# written by scripts/stamp-version.sh at bootstrap and after every refresh) names
# the MTK version whose setup files the repo has; the plugin's manifest names the
# installed version. stamp-version.sh --compare parses both (one parser, shared
# with mtk-doctor). An older stamp needs /mtk-setup --refresh — the plugin
# manager cannot change it; a newer stamp means the plugin itself is behind.
VERSION_MSG=""
STAMP_SH="$SCRIPT_DIR/../scripts/stamp-version.sh"
# CLAUDE_PLUGIN_ROOT is Claude Code's; other harnesses (S3.8) run the hook from
# the plugin tree, so its manifest sits next to this hook.
PLUGIN_MANIFEST="${CLAUDE_PLUGIN_ROOT:-$SCRIPT_DIR/..}/.claude/manifest.json"
if [ -f .claude/mtk-version.json ] && [ -f "$STAMP_SH" ] && [ -f "$PLUGIN_MANIFEST" ]; then
  VCMP="$(bash "$STAMP_SH" --compare --manifest "$PLUGIN_MANIFEST" 2>/dev/null || true)"
  read -r V_STATE V_STAMP V_PLUGIN <<<"$VCMP" || true
  case "${V_STATE:-}" in
    older) VERSION_MSG="MTK: this repo was set up with MTK ${V_STAMP}; the plugin is ${V_PLUGIN}. Run /mtk-setup --refresh to bring its setup files up to date." ;;
    newer) VERSION_MSG="MTK: this repo was set up with MTK ${V_STAMP}, newer than the installed plugin ${V_PLUGIN}. Update the plugin with the Claude Code plugin manager." ;;
  esac
fi

# --- Post-compaction recovery (source = compact) ------------------------------
# Every pointer is anchored, never cwd-relative: the hook's cwd can be any
# subdirectory. Specs and plans live under the artifact root (S1.16);
# tech-stack, tasks, handoffs and workflow state under the project root.
COMPACT_MSG=""
if [ "$SS_SOURCE" = "compact" ]; then
  PC=""
  ROOT="$(mtk_repo_root 2>/dev/null || pwd)"
  MTK_ARTIFACT_DIR="$(mtk_artifact_root "$PWD" 2>/dev/null || printf '%s' "$ROOT")"
  # Print a path relative to the project root when it is under it.
  show() { mtk_repo_relative_path "$1" "$ROOT" 2>/dev/null || printf '%s' "$1"; }

  if [ -f "$ROOT/.claude/tech-stack" ]; then
    PC="Active tech stack: $(cat "$ROOT/.claude/tech-stack")."
    if [ -f "$ROOT/.claude/tech-stack-pm" ]; then
      PC="${PC} Package manager: $(cat "$ROOT/.claude/tech-stack-pm")."
    fi
  fi

  # In-progress spec (JSON sidecar — critical for drift detection).
  if [ -d "$MTK_ARTIFACT_DIR/docs/specs" ]; then
    PC_SPEC=$(find "$MTK_ARTIFACT_DIR/docs/specs" -name '*.json' -mtime -1 2>/dev/null | awk 'NR==1' || true)
    [ -n "${PC_SPEC:-}" ] && PC="${PC} Active spec: $(show "$PC_SPEC") — read before resuming implementation or review."
  fi

  if [ -d "$MTK_ARTIFACT_DIR/docs/plans" ]; then
    PC_PLAN=$(find "$MTK_ARTIFACT_DIR/docs/plans" -name '*.md' -mtime -1 2>/dev/null | awk 'NR==1' || true)
    [ -n "${PC_PLAN:-}" ] && PC="${PC} Active plan: $(show "$PC_PLAN") — check tasks/todo.md for batch progress."
  fi

  if [ -f "$ROOT/tasks/todo.md" ] && grep -q '\[ \]' "$ROOT/tasks/todo.md" 2>/dev/null; then
    PC="${PC} Incomplete tasks in tasks/todo.md — check before starting new work."
  fi

  # Handoff: the newest note that is open — or accepted during this session —
  # and written for the current branch (a note with no branch — legacy, or
  # frontmatter without `branch:` — counts only when modified < 24h). The session ledger records no start timestamp,
  # so "accepted during this session" is approximated as accepted within the
  # last 24 hours. Helper absent or failing ⇒ the plain newest-<24h pick.
  if [ -d "$ROOT/docs/handoffs" ]; then
    PC_HANDOFF=""
    HO_OK=0
    if [ -n "$HANDOFF_STATE" ]; then
      HO_SINCE="$(date -u -d '-24 hours' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-24H +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
      HO_BRANCH="$(handoff_branch "$ROOT")"
      # Detached HEAD: a sentinel no branch-tagged note matches; legacy notes still show.
      [ -n "$HO_BRANCH" ] || HO_BRANCH="(detached)"
      if handoff_list --open --branch "$HO_BRANCH" ${HO_SINCE:+--include-accepted-since "$HO_SINCE"} --dir "$ROOT/docs/handoffs"; then
        HO_OK=1
        PC_HANDOFF="$(awk -F'\t' 'NR == 1 { print $1 }' <<<"$HO_LIST")"
      fi
    fi
    if [ "$HO_OK" -eq 0 ]; then
      PC_HANDOFF=$(find "$ROOT/docs/handoffs" -name '*.md' -mtime -1 2>/dev/null | awk 'NR==1' || true)
    fi
    [ -n "${PC_HANDOFF:-}" ] && PC="${PC} Recent handoff: $(show "$PC_HANDOFF") — read to resume previous session state."
  fi

  # Active workflow artifact: at most ONE — the newest whose status is `active`
  # (never failed/complete/abandoned) and whose updated_at is within
  # MTK_WORKFLOW_REINJECT_DAYS (default 7). A finished or week-old workflow
  # re-injected here reads as live work and restarts itself. Selection lives in
  # lib/active_workflow.py (shared with subagent-context.sh); without python3 no
  # workflow is re-injected rather than a possibly stale one.
  WF_DIR="$ROOT/.mtk/workflows"
  if [ -d "$WF_DIR" ] && command -v python3 >/dev/null 2>&1; then
    # Only the compacting session's own workflow (owner_session): another
    # session's live workflow is not this conversation's work.
    SS_SID="$(mtk_extract_json_string "$SS_INPUT" "session_id" 2>/dev/null || true)"
    WF_LINE="$(python3 "$SCRIPT_DIR/lib/active_workflow.py" --session "$SS_SID" "$WF_DIR" "${MTK_WORKFLOW_REINJECT_DAYS:-7}" path type phase 2>/dev/null || true)"
    if [ -n "$WF_LINE" ]; then
      ACTIVE_WF="${WF_LINE%%	*}"
      WF_REST="${WF_LINE#*	}"
      WF_TYPE="${WF_REST%%	*}"
      WF_PHASE="${WF_REST#*	}"
      WF_BASENAME=$(basename "$ACTIVE_WF" .json)
      WF_EVENTS="$WF_DIR/${WF_BASENAME}.events.jsonl"
      LAST_EVENT=""
      if [ -f "$WF_EVENTS" ]; then
        LAST_EVENT=$(tail -n 1 "$WF_EVENTS" 2>/dev/null | grep -o '"event_type"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"\([^"]*\)"$/\1/' || true)
      fi
      WF_MSG="Active workflow: ${WF_BASENAME} (type=${WF_TYPE}, phase=${WF_PHASE}"
      [ -n "${LAST_EVENT:-}" ] && WF_MSG="${WF_MSG}, last_event=${LAST_EVENT}"
      WF_MSG="${WF_MSG}) — read $(show "$ACTIVE_WF") before advancing; do not re-init."
      PC="${PC} ${WF_MSG}"
    fi
  fi

  # Anti-resurrection framing: recovered state is REFERENCE, not instruction.
  # Without it, a task the user cancelled or superseded before compaction reads
  # as live work and restarts itself — the summary outlives the decision that
  # killed it.
  if [ -n "${PC// /}" ]; then
    FRAMING="These pointers are a HISTORICAL SNAPSHOT of pre-compaction state, for reference — not instructions to act on. The latest user message always wins over anything recovered here. If the user cancelled, paused, or superseded any of this work (stop / undo / roll back / never mind / a new direction), treat that item as closed — do not resume it. Before acting on any pointer, confirm it is still what the user wants now."
    COMPACT_MSG="POST-COMPACTION RECOVERY (reference only): ${PC# } ${FRAMING}"
  fi
fi

# Build the context message
BASE_MSG="Moberg toolkit is active. Available entry points: /mtk and /mtk-setup. Skills load on demand via progressive disclosure."
CONTEXT="$BASE_MSG"
[[ -n "$RECOVERY_MSG" ]] && CONTEXT="${CONTEXT} ${RECOVERY_MSG}"
[[ -n "$VERSION_MSG" ]] && CONTEXT="${CONTEXT} ${VERSION_MSG}"
[[ -n "$COMPACT_MSG" ]] && CONTEXT="${CONTEXT} ${COMPACT_MSG}"

# Escape for JSON (bash parameter substitution — no external deps)
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

ESCAPED_CONTEXT="$(json_escape "$CONTEXT")"

# Platform detection and output routing
if [[ -n "${CURSOR_PLUGIN_ROOT:-}" ]]; then
  # Cursor format
  printf '{"context": "%s"}\n' "$ESCAPED_CONTEXT"
elif [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]] && [[ -z "${COPILOT_CLI:-}" ]]; then
  # Claude Code format — SessionStart's model-visible channel is
  # hookSpecificOutput.additionalContext (a top-level "context" field is ignored).
  mtk_emit_additional_context "SessionStart" "$CONTEXT"
elif [[ -n "${COPILOT_CLI:-}" ]]; then
  # GitHub Copilot CLI — SDK standard format
  printf '{"role": "system", "content": "%s"}\n' "$ESCAPED_CONTEXT"
elif [[ -n "${GEMINI_EXTENSION_ROOT:-}" ]]; then
  # Gemini CLI format
  printf '{"context": "%s"}\n' "$ESCAPED_CONTEXT"
else
  # Unknown platform — SDK standard format as fallback
  printf '{"role": "system", "content": "%s"}\n' "$ESCAPED_CONTEXT"
fi

#!/usr/bin/env bash
# Git pre-commit hook — runs the MTK deterministic linter on staged changes.
# Blocks the commit if any critical finding is detected.
#
# Installed by /mtk:setup-bootstrap as a symlink from .git/hooks/pre-commit.
# Bypass with: git commit --no-verify

set -euo pipefail

# Resolve the linter relative to THIS hook's real location, not the repo being
# committed to. Bootstrap installs .git/hooks/pre-commit as a symlink into the
# plugin checkout, so the linter lives next to the resolved script — never in
# the target repo. git runs this hook with cwd = the target repo toplevel, and
# the linter diffs that working directory while loading patterns from the plugin.
mtk_realpath() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"
    return
  fi
  # Fallback: resolve symlinks manually (no readlink -f on stock macOS).
  local p="$1" target
  while [ -L "$p" ]; do
    target="$(readlink "$p")"
    case "$target" in
      /*) p="$target" ;;
      *)  p="$(cd "$(dirname "$p")" && pwd)/$target" ;;
    esac
  done
  printf '%s/%s\n' "$(cd "$(dirname "$p")" && pwd)" "$(basename "$p")"
}

SELF="$(mtk_realpath "$0")"
LINTER="$(cd "$(dirname "$SELF")/.." && pwd)/pre-commit-linters.sh"

# If the linter genuinely can't be found, warn once and let the commit proceed.
# A missing tooling dependency must never silently pass unnoticed, nor block a
# commit — the AI review remains the enforcing gate.
if [ ! -x "$LINTER" ]; then
  printf 'MTK pre-commit: linter not found at %s — skipping deterministic lint.\n' "$LINTER" >&2
  exit 0
fi

# Run the linter in JSON mode and capture output. A broken linter invocation is
# safer as a blocked commit than a silent pass.
if ! RESULT="$("$LINTER" --cached 2>&1)"; then
  printf '\n'
  printf '==============================================================\n'
  printf '  MTK pre-commit: linter failed to run — commit blocked\n'
  printf '==============================================================\n\n'
  printf '%s\n' "$RESULT"
  printf '\nFix the linter contract above, or bypass with: git commit --no-verify\n'
  exit 1
fi

# Parse the verdict from JSON output.
# Uses parameter expansion to avoid depending on jq.
if printf '%s' "$RESULT" | grep -q '"verdict":"NEEDS_CHANGES"'; then
  printf '\n'
  printf '==============================================================\n'
  printf '  MTK pre-commit: critical finding(s) detected — commit blocked\n'
  printf '==============================================================\n\n'
  # Re-run in human mode for readable output.
  "$LINTER" --cached --human 2>/dev/null || true
  printf '\nFix the issues above, or bypass with: git commit --no-verify\n'
  exit 1
fi
